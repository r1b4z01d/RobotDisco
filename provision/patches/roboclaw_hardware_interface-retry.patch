 #include "roboclaw_hardware_interface/roboclaw_hardware_interface.hpp"
 
+#include <chrono>
 #include <iostream>
+#include <string>
 #include <roboclaw_serial/device.hpp>
 
 namespace roboclaw_hardware_interface
 {
 
+namespace
+{
+// One failed exchange is usually a late reply (the serial device waits 25 ms for the first byte, and a loaded
+// computer can take longer to hand it over): ask once more before giving the cycle up.
+constexpr int kAttempts = 2;
+// How long cycles may keep failing before the hardware reports an error. The board's own serial timeout (1 s on
+// Robot Disco) stops the motors when nothing valid reaches it, so the interface gives up before the board does.
+constexpr std::chrono::milliseconds kMaxFailing{500};
+
+template<typename Exchange>
+bool attempt(Exchange && exchange, std::string & what)
+{
+  for (int i = 0; i < kAttempts; ++i) {
+    try {
+      exchange();
+      return true;
+    } catch (const std::exception & e) {
+      what = e.what();
+    }
+  }
+  return false;
+}
+}  // namespace
+
+return_type RoboClawHardwareInterface::cycle_result(
+  const char * which, bool ok, const std::string & what, FailureRun & run)
+{
+  const auto now = std::chrono::steady_clock::now();
+  if (ok) {
+    if (run.cycles > 0) {
+      std::cerr << "RoboClaw " << which << " recovered after " << run.cycles << " failed cycle(s)." << std::endl;
+    }
+    run.cycles = 0;
+    return return_type::OK;
+  }
+  if (run.cycles++ == 0) {
+    run.since = now;
+    std::cerr << "RoboClaw " << which << " failed after " << kAttempts << " attempts (" << what <<
+      "); tolerating failures for " << kMaxFailing.count() << " ms." << std::endl;
+  }
+  if (now - run.since > kMaxFailing) {
+    std::cerr << "RoboClaw " << which << " has failed for " << run.cycles << " cycles in a row (" << what <<
+      "): giving up." << std::endl;
+    return return_type::ERROR;
+  }
+  return return_type::OK;
+}
