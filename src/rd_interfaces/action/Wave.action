# Play a recorded arm gesture (wave by default) collision-aware through MoveIt, then return.
# Served by rd_arm. Called by rd_face (greeting) and rd_voice.
string motion "wave"        # name of a recorded motion in rd_arm's motion library
string return_to "home"     # pose to end at: "home" (VLA home), "start" (where the arm was), "none"
float32 speed_scale 1.0     # 0..1 of the recording's velocity
bool wiggle_fingers true    # the hand's finger wiggle during the gesture
---
bool success
string message              # "done", "cancelled", "arm_not_ready", "collision", "protective_stop"
float32 seconds
---
float32 progress            # 0..1 through the motion
string phase                # "planning", "moving", "returning"
