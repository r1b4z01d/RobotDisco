<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rd_voice</name>
  <version>2.0.0</version>
  <description>Robot Disco voice assistant: Whisper ears, the wake phrase, the brain (rules + Claude / Ollama with skills), landmark tasks through the nav and VLA actions</description>
  <maintainer email="bryanribas@gmail.com">Bryan Ribas</maintainer>
  <license>CC-BY-NC-SA-4.0</license>
  <depend>rd_interfaces</depend>
  <exec_depend>rd_bringup</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rd_nav</exec_depend>
  <exec_depend>rd_audio</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
