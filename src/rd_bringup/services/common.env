# Sourced by every unit's command line (bash -lc): the workspace, the DDS profile, the config file.
export RD_WS=/home/rd/RobotDisco
export RD_ROBOT_CONFIG=$RD_WS/config/robot.yaml
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export CYCLONEDDS_URI=file://$RD_WS/provision/cyclonedds.xml
export ROS_DOMAIN_ID=0
export XDG_RUNTIME_DIR=/run/user/1000
export HF_HUB_OFFLINE=1
# the robot's own landmarks and their photos (v1's Scripts/landmarks): outside the source tree, where a deploy
# would put the rig's three placeholder landmarks back
export RD_LANDMARKS_DIR=/mnt/data/landmarks
source /opt/ros/jazzy/setup.bash
source $RD_WS/install/setup.bash
