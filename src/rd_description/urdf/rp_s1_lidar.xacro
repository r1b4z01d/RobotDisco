<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <joint name="rp_s1_lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="rp_s1_lidar"/>
        <origin xyz="0.21 0 0.14" rpy="0 0.0 3.14"/>
    </joint>

    <link name="rp_s1_lidar">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.03"/>
            </geometry>
            <material name="black"/>
        </visual>
        <visual>
            <origin xyz="0 0 -0.03"/>
            <geometry>
                <cylinder radius="0.03" length="0.03"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.02"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.02" radius="0.03">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>




</robot>