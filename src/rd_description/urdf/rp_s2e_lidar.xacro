<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <joint name="rp_s2e_lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="rp_s2e_lidar"/>
        <origin xyz="-0.52 0.0 0.0" rpy="0.0 0.0 0"/>
    </joint>

    <link name="rp_s2e_lidar">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.03"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <visual>
            <origin xyz="0 0 -0.03"/>
            <geometry>
                <cylinder radius="0.05" length="0.03"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.06"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>




</robot>