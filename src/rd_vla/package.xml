<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rd_vla</name>
  <version>2.0.0</version>
  <description>Robot Disco VLA: the inference server with pluggable backends, the RunPolicy action, the recorder, teleop inputs, the eval registry</description>
  <maintainer email="bryanribas@gmail.com">Bryan Ribas</maintainer>
  <license>CC-BY-NC-SA-4.0</license>

  <depend>rd_interfaces</depend>
  <exec_depend>rd_bringup</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
