<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rd_manager</name>
  <version>2.0.0</version>
  <description>Robot Disco web manager: the one console (FastAPI + rclpy): live map, 3D, route editor, landmarks, maps, services, Folks, datasets, models, evals, the arm and the hand</description>
  <maintainer email="bryanribas@gmail.com">Bryan Ribas</maintainer>
  <license>CC-BY-NC-SA-4.0</license>
  <depend>rd_interfaces</depend>
  <exec_depend>rd_bringup</exec_depend>
  <exec_depend>rd_nav</exec_depend>
  <exec_depend>rd_vla</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-httpx</test_depend>
  <test_depend>launch_testing</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
